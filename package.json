{
  "name": "clarity-software-solutions-website",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "keywords": [
    ""
  ],
  "license": "",
  "author": "",
  "scripts": {
    "tailwind": "npx @tailwindcss/cli -i ./src/css/styles.css -o ./public/css/styles.css && npm run copy:html",

    "copy": "npm-run-all --parallel copy:*",
    "copy:html": "copyfiles -u 1 ./src/*.html public",
    "copy:images": "copyfiles -u 1 './src/images/**/*.*' public",

    "watch": "npm-run-all --parallel watch:*",
    "watch:html": "onchange 'src/*.html' -- npm run tailwind",
    "watch:images": "onchange 'src/images' -- npm run copy:images",
    "watch:tailwind": "onchange 'src/css' -- npm run tailwind",

    "serve": "browser-sync start --server public --files public",
    "dev": "npm-run-all copy --parallel watch serve",

    "build": "npm-run-all copy:html build:*",
    "postbuild": "postcss public/css/*.css -u autoprefixer cssnano -r --no-map"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.2",
    "browser-sync": "^3.0.2",
    "copyfiles": "^2.4.1",
    "cssnano": "^8.0.0",
    "npm-run-all2": "^9.0.0",
    "onchange": "^7.1.0",
    "postcss-cli": "^11.0.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
