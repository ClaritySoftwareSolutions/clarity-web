{
  "name": "clarity-software-solutions-website",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "keywords": [
    ""
  ],
  "license": "",
  "author": "",
  "scripts": {
    "tailwind": "npx @tailwindcss/cli -i ./src/css/styles.css -o ./public/css/styles.css && npm run copy:html",
    "copy": "npm-run-all --parallel copy:*",
    "copy:html": "copyfiles -u 1 ./src/*.html public",
    "copy:images": "copyfiles -u 1 './src/images/**/*.*' public",
    "copy:robots": "copyfiles -u 1 './src/robots.txt' public",
    "copy:info": "copyfiles -u 1 './src/info.json' public",
    "watch": "npm-run-all --parallel watch:*",
    "watch:html": "onchange 'src/*.html' -- npm run tailwind",
    "watch:images": "onchange 'src/images' -- npm run copy:images",
    "watch:tailwind": "onchange 'src/css' -- npm run tailwind",
    "replace": "npm-run-all --sequential replace:*",
    "replace:version": "replace-in-files --string='{{ VERSION }}' --replacement=`git rev-parse HEAD` public/info.json",
    "replace:date": "replace-in-files --string='{{ BUILD_DATE }}' --replacement=`git --no-pager log -1 --format=%cs` public/info.json",
    "serve": "browser-sync start --server public --files public",
    "dev": "npm-run-all copy --parallel watch serve",
    "clean": "rm -rf public",
    "prebuild": "npm-run-all clean",
    "build": "npm-run-all tailwind copy replace",
    "postbuild": "postcss public/css/*.css -u autoprefixer cssnano -r --no-map"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.6.0",
    "browser-sync": "^3.0.2",
    "copyfiles": "^2.4.1",
    "cssnano": "^9.0.4",
    "npm-run-all2": "^9.0.0",
    "onchange": "^7.1.0",
    "postcss-cli": "^12.0.0",
    "replace-in-files-cli": "4.0.0"
  },
  "dependencies": {
    "tailwindcss": "^4.3.3"
  }
}
